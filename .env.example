# Template for the real ".env" file.
# Copy this file, rename the copy to ".env", and fill in real values.
# (".env" holds your real secrets — don't commit it to git.)

# SECRET_KEY signs the session cookie so it can't be forged.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database location. "sqlite:///habits.db" = a habits.db file in this
# project folder. Leave it as is for local development.
DATABASE_URL=sqlite:///habits.db
